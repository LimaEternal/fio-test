# FIO-конфиг для SAS накопителей.
#
# SAS — серверный интерфейс с хорошей поддержкой очередей:
#   - последовательный доступ: bs=64k, QD32;
#   - случайный доступ: 2 потока (QD32 x 2 = QD64).
#
# Все тесты идут напрямую к диску (direct=1, минуя page cache)
# через асинхронный движок libaio. Секция [global] применяется ко всем
# тестам. Файл можно запускать напрямую:
#   fio configs/sas.fio --filename=/dev/sda

[global]
ioengine=libaio
direct=1
ramp_time=15
runtime=30
time_based=1
group_reporting=1
norandommap=1
output-format=json

[seq_read]
rw=read
bs=64k
iodepth=32
numjobs=1

[seq_write]
rw=write
bs=64k
iodepth=32
numjobs=1

[rand_read]
rw=randread
bs=4k
iodepth=32
numjobs=2

[rand_write]
rw=randwrite
bs=4k
iodepth=32
numjobs=2
