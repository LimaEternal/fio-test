# Конфиг предварительного заполнения дисков.
# Скрипт превращает каждую строку key=value в аргумент fio (--key=value).
# Здесь меняется движок и параметры записи перед запуском prefill
# (выполняется по умолчанию перед тестами, отключается флагом -p).
#
# Движки:
#   io_uring — самый быстрый в этой среде (проверен на сервере);
#   psync    — максимально совместимый (используется как авто-fallback).
#
# Если движок не запишет ни байта за 8 секунд, скрипт один раз
# автоматически переключится на psync и продолжит заполнение.
#
# iodepth=16 вместо 1 ускоряет заполнение всего объёма (QD16) — запись
# остаётся последовательной (rw=write, bs=128k), на реальные тесты префилл
# не влияет: 3.6-3.8 ГБ/с это практический максимум seq_write P5510 (TLC
# sustained), запись упирается в устройство, а не в линк/глубину очереди.
ioengine=io_uring
direct=1
rw=write
bs=128k
iodepth=16
size=100%
numjobs=1
group_reporting=1
